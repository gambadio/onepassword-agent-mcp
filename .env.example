# Optional: state directory. Defaults to ~/.onepassword-mcp
# ONEPASSWORD_MCP_HOME=/Users/you/.onepassword-mcp

# Optional: override path to 1Password CLI.
# OP_PATH=/opt/homebrew/bin/op

# Optional: choose a 1Password account.
# OP_ACCOUNT=example.1password.com

# Optional: use a service account token instead of desktop app integration.
# Do not commit this.
# OP_SERVICE_ACCOUNT_TOKEN=ops_...

# Optional: require this token for admin API calls.
# ONEPASSWORD_MCP_ADMIN_TOKEN=change-me

# Optional: admin server binding.
# ADMIN_HOST=127.0.0.1
# ADMIN_PORT=7319
